# AICORE public website production environment.
#
# Deployment model:
# - Public website frontend is served from https://www.aicoret.com
# - platform-api is the same backend used by GrowthOS.
# - The production nginx config for www.aicoret.com should proxy /api/* to platform-api.
#
# Leave this empty to make browser API calls relative to the website origin,
# for example https://www.aicoret.com/api/v1/public/articles.
# Set it only if the website must call a separate API origin, for example:
# VITE_PLATFORM_API_BASE_URL=https://api.aicoret.com
VITE_PLATFORM_API_BASE_URL=

# Optional analytics. Leave empty until the production IDs are available.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=

# Optional frontend error reporting DSN. This value is public by design,
# but keep it empty until Sentry/browser reporting is configured.
VITE_SENTRY_DSN=
